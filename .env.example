# Book2Skill LLM 一次性配置示例
# 用法：复制本文件为 .env，按需取消注释并填值。
# .env 已被 .gitignore 排除，不会进入版本控制。
# 配置优先级：命令行参数 (--llm*) > 系统环境变量 > .env 文件 > 默认 Mock（离线）。
#   - 通用变量 LLM_* 优先级高于旧版 OPENAI_*（两者均支持，向后兼容）。
# 配置一次后，所有 book2skill analyze/batch 命令均自动生效，无需每次传参。

# 默认 LLM 适配器：mock（离线，默认）/ openai / compatible
# openai 与 compatible 等价，都走 OpenAI 兼容协议（OpenAI / Azure /
# 阿里云百炼 / Ollama / vLLM / LM Studio 等）。设为 compatible 即无需每次 --llm。
BOOK2SKILL_LLM=compatible

# OpenAI 兼容端点 base URL。
# 云端官方 API 留空即可；其他供应商填服务地址，例如：
#   阿里云百炼 : https://dashscope.aliyuncs.com/compatible-mode/v1
#   LM Studio  : http://localhost:1234/v1
#   Ollama     : http://localhost:11434/v1
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名（云端如 gpt-4o / gpt-4o-mini；百炼如 qwen-plus / qwen-max；本地如 qwen2.5:7b）
# LLM_MODEL=qwen-plus

# API Key（云端填真实 key；本地部署通常不校验，填 local 即可）
# 阿里云百炼：在 https://bailian.console.aliyun.com/ 获取 API-KEY
# LLM_API_KEY=sk-替换为你的密钥

# ---- 旧版变量（仍生效，优先级低于 LLM_*）----------------------------------
# OPENAI_BASE_URL=
# OPENAI_MODEL=
# OPENAI_API_KEY=
