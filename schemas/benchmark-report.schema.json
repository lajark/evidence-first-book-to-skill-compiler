{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lajark/evidence-first-book-to-skill-compiler/blob/main/schemas/benchmark-report.schema.json",
  "title": "Evidence-first public benchmark report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "generated_at",
    "environment",
    "source_policy",
    "cases",
    "metrics",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "provider", "network"],
      "properties": {
        "python": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "network": {"type": "string", "minLength": 1}
      }
    },
    "source_policy": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "input_kind", "rights_note", "expected_outcome", "result"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "input_kind": {"type": "string", "minLength": 1},
          "rights_note": {"type": "string", "minLength": 1},
          "expected_outcome": {"type": "string", "minLength": 1},
          "result": {"enum": ["passed", "failed", "not_measured"]}
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "status", "value", "unit", "method", "evidence", "limitations"],
        "properties": {
          "metric_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["measured", "not_measured"]},
          "value": {"type": ["number", "integer", "null"]},
          "unit": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
