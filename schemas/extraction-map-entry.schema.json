{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtractionMapEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "block_id",
    "source_id",
    "text_sha256",
    "locator"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "block_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "locator": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "page",
            "chapter",
            "paragraph",
            "table",
            "sheet",
            "unknown"
          ]
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "chapter": {
          "type": [
            "string",
            "null"
          ]
        },
        "paragraph": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
