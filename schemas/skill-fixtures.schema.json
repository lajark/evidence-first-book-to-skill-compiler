{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillFixtureSet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_set_id", "skill_name", "fixtures"],
  "properties": {
    "schema_version": {"const": 1},
    "fixture_set_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "skill_name": {"type": "string"},
    "fixtures": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_id", "kind", "prompt", "should_trigger", "assertions"],
        "properties": {
          "fixture_id": {"type": "string"},
          "kind": {
            "enum": [
              "positive_trigger", "negative_trigger", "normal_execution",
              "missing_input", "conflict", "out_of_scope", "output_format"
            ]
          },
          "prompt": {"type": "string", "minLength": 1},
          "should_trigger": {"type": "boolean"},
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}
