{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalysisBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collection_id",
    "source_ids",
    "structure",
    "candidate_units",
    "review_queue"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "collection_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "structure": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "candidate_units": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "review_queue": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "suggested_skills": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "analysis_run": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "schema_version",
        "provider",
        "model",
        "prompt_version",
        "response_schema_version",
        "parameters",
        "fallback_allowed",
        "invocations"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "provider": {"enum": ["mock", "openai"]},
        "model": {"type": "string"},
        "prompt_version": {"type": "string"},
        "response_schema_version": {"type": "string"},
        "locale": {"enum": ["zh-CN", "en"], "default": "zh-CN"},
        "parameters": {"type": "object"},
        "fallback_allowed": {"type": "boolean"},
        "invocations": {"type": "array"}
      }
    },
    "quality_review": {
      "type": ["array", "null"],
      "description": "Optional selective quality review patches (OPT-P1-10).",
      "items": {"$ref": "quality-review.schema.json"}
    }
  }
}
