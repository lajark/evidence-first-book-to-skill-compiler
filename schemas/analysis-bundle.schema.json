{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalysisBundle",
  "type": "object",
  "required": [
    "schema_version",
    "collection_id",
    "source_ids",
    "structure",
    "candidate_units",
    "review_queue"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "collection_id": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "structure": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "candidate_units": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "review_queue": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "suggested_skills": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
