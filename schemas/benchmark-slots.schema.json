{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-slots.schema.json",
  "title": "BenchmarkSlots",
  "description": "Offline benchmark-slot expectations per book (OPT-P1-11). A slot is covered by candidate evidence, or optionally by matching source structure evidence when structure_keywords is declared.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "book_id", "slots"],
  "properties": {
    "schema_version": {"const": 1},
    "book_id": {"type": "string", "minLength": 1},
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_id", "rubric_item_id", "kinds", "keywords"],
        "properties": {
          "slot_id": {"type": "string", "minLength": 1},
          "rubric_item_id": {"type": "string", "minLength": 1},
          "kinds": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "keywords": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "min_count": {"type": "integer", "minimum": 1, "default": 1},
          "structure_keywords": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
