{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormalizedBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "normalized_bundle_id",
    "collection_id",
    "input_bundle_sha256",
    "generator_version",
    "template_version",
    "target_spec",
    "source_ids",
    "units",
    "conflicts",
    "review_queue"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "normalized_bundle_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "collection_id": {"type": "string", "minLength": 1},
    "input_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generator_version": {"type": "string", "minLength": 1},
    "template_version": {"type": "string", "minLength": 1},
    "target_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision", "verified_on", "reference_validator"],
      "properties": {
        "name": {"const": "agent-skills"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "verified_on": {"type": "string"},
        "reference_validator": {"type": "string"}
      }
    },
    "source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id", "kind", "content", "conditions", "exceptions",
          "source_refs", "confidence", "review_status", "record_version",
          "supersedes", "evidence_level", "evidence_note"
        ],
        "properties": {
          "unit_id": {"type": "string"},
          "kind": {"type": "string"},
          "content": {"type": "string", "minLength": 1},
          "conditions": {"type": "array", "items": {"type": "string"}},
          "exceptions": {"type": "array", "items": {"type": "string"}},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "block_id", "quote_sha256", "quote_chars"],
              "properties": {
                "source_id": {"type": "string"},
                "block_id": {"type": "string"},
                "quote_sha256": {
                  "type": ["string", "null"],
                  "pattern": "^[0-9a-f]{64}$"
                },
                "quote_chars": {"type": "integer", "minimum": 0}
              }
            }
          },
          "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "review_status": {"type": "string"},
          "record_version": {"type": "integer", "minimum": 1},
          "supersedes": {"type": ["string", "null"]},
          "evidence_level": {
            "enum": ["primary", "secondary", "inferred", "user_added"]
          },
          "evidence_note": {"type": ["string", "null"]}
        }
      }
    },
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "review_queue": {"type": "array", "items": {"type": "object"}}
  }
}
