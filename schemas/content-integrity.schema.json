{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://book2skill.local/schemas/content-integrity.schema.json",
  "title": "Generated Skill Content Integrity Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "expected_source_count",
    "source_count",
    "expected_unit_count",
    "rendered_unit_count",
    "missing_unit_ids",
    "extra_unit_ids",
    "duplicate_unit_ids",
    "content_mismatch_unit_ids",
    "content_hash_mismatch_unit_ids",
    "missing_source_ids",
    "extra_source_ids",
    "duplicate_source_ids",
    "source_hash_mismatch_ids",
    "missing_source_refs",
    "extra_source_refs",
    "duplicate_source_refs",
    "missing_files",
    "malformed_files",
    "blocking_reasons",
    "blocked"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "expected_source_count": {"type": "integer", "minimum": 0},
    "source_count": {"type": "integer", "minimum": 0},
    "expected_unit_count": {"type": "integer", "minimum": 0},
    "rendered_unit_count": {"type": "integer", "minimum": 0},
    "missing_unit_ids": {"type": "array", "items": {"type": "string"}},
    "extra_unit_ids": {"type": "array", "items": {"type": "string"}},
    "duplicate_unit_ids": {"type": "array", "items": {"type": "string"}},
    "content_mismatch_unit_ids": {"type": "array", "items": {"type": "string"}},
    "content_hash_mismatch_unit_ids": {"type": "array", "items": {"type": "string"}},
    "missing_source_ids": {"type": "array", "items": {"type": "string"}},
    "extra_source_ids": {"type": "array", "items": {"type": "string"}},
    "duplicate_source_ids": {"type": "array", "items": {"type": "string"}},
    "source_hash_mismatch_ids": {"type": "array", "items": {"type": "string"}},
    "missing_source_refs": {"type": "array", "items": {"type": "string"}},
    "extra_source_refs": {"type": "array", "items": {"type": "string"}},
    "duplicate_source_refs": {"type": "array", "items": {"type": "string"}},
    "missing_files": {"type": "array", "items": {"type": "string"}},
    "malformed_files": {"type": "array", "items": {"type": "string"}},
    "blocking_reasons": {"type": "array", "items": {"type": "string"}},
    "blocked": {"type": "boolean"}
  }
}
